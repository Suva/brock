  "type": "module",
  "scripts": {
    "start": "tauri dev",
    "dev": "vite",
    "build": "vite build",
    "test": "node --test test/*.test.ts && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:core": "node --test test/*.test.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "package": "tauri build",
    "site": "node scripts/build-site.mjs --serve",
    "build:site": "node scripts/build-site.mjs",
    "preversion": "node scripts/changelog.mjs check",
    "version": "node scripts/changelog.mjs release && node scripts/sync-version.mjs",
    "tauri": "tauri"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.4",
    "@lezer/markdown": "^1.8.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
