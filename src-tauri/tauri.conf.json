{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brock",
  "version": "../package.json",
  "identifier": "app.getbrock.brock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Brock",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 25
        },
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../scripts/brock-mcp.mjs": "brock-mcp.mjs"
    },
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0QjVFMkYwN0E4RUUyMzUKUldRMTRvNTY4T0sxWkpIUlRzWkk5V0c5eVpESkpQenJ6UW83b1JTS3VJVlk4TkRjSU53NndJbEsK",
      "endpoints": [
        "https://github.com/Suva/brock/releases/latest/download/latest.json"
      ]
    }
  }
}
